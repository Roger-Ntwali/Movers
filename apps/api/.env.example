NODE_ENV=development
PORT=4000

# Postgres connection string, e.g. postgres://user:password@localhost:5432/movers_rwanda
DATABASE_URL=

# Any long random string (32+ chars recommended)
JWT_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Cloudinary (optional in dev — image uploads are disabled until these are set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run db:seed` to create the first admin login
SEED_ADMIN_EMAIL=admin@moversrwanda.com
SEED_ADMIN_PASSWORD=ChangeMe123!
